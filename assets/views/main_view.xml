<vbox styleNames="root-container">
    <label text="Dynamotivation Software Hub" styleNames="header-title" />
    <label text="Native Cross-Platform Desktop Management with HaxeUI &amp; wxWidgets" styleNames="header-subtitle" />
    
    <hbox styleNames="action-bar">
        <textfield id="itemNameInput" placeholder="Enter software package or service name..." styleNames="input-name" />
        <button id="registerButton" text="Register Software" styleNames="primary-button" />
        <button id="refreshButton" text="Refresh" />
    </hbox>

    <label text="Registered Software Hub Items:" style="font-weight: bold; margin-top: 4px;" />
    <listview id="itemListView" styleNames="content-list" />
</vbox>
