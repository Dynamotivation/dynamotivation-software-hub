import { AboutSlint, Button, ComboBox, LineEdit, Palette, ScrollView, VerticalBox } from "std-widgets.slint";
import { PackageRow, PackageStatus, ThemePreference } from "types.slint";
import { Theme } from "theme.slint";
import { SurfaceCard } from "components/card.slint";
import { PackageListItem } from "components/package-list-item.slint";
import { PackageDetailPane } from "components/package-detail-pane.slint";

// Re-export so the generated Rust API contains these types.
export { PackageRow, PackageStatus, ThemePreference }

export component AppWindow inherits Window {
    title: @tr("Dynamotivation Software Hub");
    no-frame: true;
    preferred-width: 980px;
    preferred-height: 760px;
    min-width: 440px;
    min-height: 520px;
    background: Palette.background;

    in property <[PackageRow]> packages: [];
    in property <[PackageRow]> installed-packages: [];
    in property <[PackageRow]> available-packages: [];
    in property <int> updates-count: 0;
    in property <string> error-message;
    in property <string> version;
    in-out property <string> search-query: "";
    in-out property <ThemePreference> theme: ThemePreference.system;
    // Resolved OS dark-mode flag so "System theme" sets an explicit scheme.
    in property <bool> system-dark: false;

    // Currently selected package for the wide Steam-like master-detail layout.
    in-out property <PackageRow> selected-package: {
        id: "geo-background-generator",
        name: "Geo Background Generator",
        description: "Geometric pattern background generator with customizable gradients",
        version: "1.8.2",
        latest-version: "2.0.0",
        status: PackageStatus.update-available,
    };

    property <bool> wide-layout: true;
    property <bool> available-expanded: true;
    property <bool> settings-open: false;
    property <string> draft-package-name: "";

    // Returns true on success; Rust sets `error-message` otherwise.
    callback register-package(string) -> bool;
    callback refresh-packages();
    callback search-edited(string);
    callback theme-selected(ThemePreference);

    // Custom frameless window chrome callbacks
    callback move-window(length, length);
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback resize-window-east(length);
    callback resize-window-south(length);
    callback resize-window-southeast(length, length);

    function apply-theme() {
        Palette.color-scheme = root.theme == ThemePreference.dark ? ColorScheme.dark
            : root.theme == ThemePreference.light ? ColorScheme.light
            : root.system-dark ? ColorScheme.dark : ColorScheme.light;
    }

    function update-responsive-layout() {
        root.wide-layout = root.width >= 760px;
    }

    function submit() {
        if (root.register-package(root.draft-package-name)) {
            root.draft-package-name = "";
        }
    }

    init => {
        root.apply-theme();
        root.update-responsive-layout();
    }
    changed width => { root.update-responsive-layout(); }
    changed theme => { root.apply-theme(); }
    changed system-dark => { root.apply-theme(); }

    about-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 320px;

        Rectangle {
            background: Theme.card-background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.card-border;

            VerticalBox {
                Text {
                    text: @tr("Dynamotivation Software Hub {}", root.version);
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }
                AboutSlint { }
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.window-background;
        border-width: 1px;
        border-color: Theme.window-frame-border;

        VerticalLayout {
            spacing: 0px;

            // Custom Integrated Top Title Bar + Brand Header Banner (no stock OS titlebar)
            Rectangle {
                height: 82px;
                vertical-stretch: 0;
                background: Theme.header-background;

                // Drag region covering the custom title/header bar
                header-drag-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    moved => {
                        if (self.pressed) {
                            root.move-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                    double-clicked => {
                        root.toggle-maximize-window();
                    }
                }

                VerticalLayout {
                    HorizontalLayout {
                        vertical-stretch: 1;
                        padding-left: 20px;
                        padding-right: 0px;
                        spacing: 12px;

                        // Brand Logo + Title Stack
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 14px;
                            alignment: start;

                            // Brand Logo (Mint/Cyan 'D' with white inner counter on coral/maroon banner)
                            VerticalLayout {
                                alignment: center;

                                Image {
                                    width: 40px;
                                    height: 40px;
                                    source: @image-url("assets/dynamotivation-logo-dark.svg");
                                    image-fit: contain;
                                }
                            }

                            // Brand Title Stack
                            VerticalLayout {
                                spacing: 1px;
                                alignment: center;

                                Text {
                                    text: @tr("Dynamotivation");
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.header-muted-foreground;
                                }

                                Text {
                                    text: @tr("Software Hub");
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: Theme.header-foreground;
                                }
                            }
                        }

                        // Right-side Stack: Window Caption Controls at top-right, Settings button bottom-right
                        VerticalLayout {
                            alignment: stretch;

                            // Top-right Window Control Buttons
                            HorizontalLayout {
                                alignment: end;
                                spacing: 0px;

                                // Minimize
                                Rectangle {
                                    width: 44px;
                                    height: 30px;
                                    background: min-touch.has-hover
                                        ? Theme.header-hover-background
                                        : Colors.transparent;

                                    min-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: @tr("Minimize");
                                        clicked => { root.minimize-window(); }
                                    }

                                    Image {
                                        width: 14px;
                                        height: 14px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("assets/window-minimize.svg");
                                        colorize: Theme.header-foreground;
                                    }
                                }

                                // Maximize / Restore
                                Rectangle {
                                    width: 44px;
                                    height: 30px;
                                    background: max-touch.has-hover
                                        ? Theme.header-hover-background
                                        : Colors.transparent;

                                    max-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: @tr("Maximize");
                                        clicked => { root.toggle-maximize-window(); }
                                    }

                                    Image {
                                        width: 14px;
                                        height: 14px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("assets/window-maximize.svg");
                                        colorize: Theme.header-foreground;
                                    }
                                }

                                // Close
                                Rectangle {
                                    width: 46px;
                                    height: 30px;
                                    background: close-touch.has-hover
                                        ? Theme.window-close-hover
                                        : Colors.transparent;

                                    close-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: @tr("Close");
                                        clicked => { root.close-window(); }
                                    }

                                    Image {
                                        width: 14px;
                                        height: 14px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("assets/window-close.svg");
                                        colorize: Theme.header-foreground;
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                            }

                            // Bottom-right Settings Button with margin to window border and separation line
                            HorizontalLayout {
                                alignment: end;
                                padding-right: 12px;
                                padding-bottom: 8px;

                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: settings-touch.has-hover || root.settings-open
                                        ? Theme.header-hover-background
                                        : Colors.transparent;

                                    settings-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: @tr("Settings");
                                        clicked => {
                                            root.settings-open = !root.settings-open;
                                        }
                                    }

                                    Image {
                                        width: 18px;
                                        height: 18px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("assets/settings.svg");
                                        colorize: Theme.header-foreground;
                                    }
                                }
                            }
                        }
                    }

                    // Signature mint-to-cyan gradient accent bar at bottom of header
                    Rectangle {
                        height: 3px;
                        vertical-stretch: 0;
                        background: Theme.brand-gradient;
                    }
                }
            }

            // NARROW TOOLBOX LAYOUT (< 760px) — Scrollbar on the far left edge of the window
            if !root.wide-layout: HorizontalLayout {
                vertical-stretch: 1;

                // Far-left custom vertical scrollbar
                VerticalLayout {
                    width: 14px;
                    horizontal-stretch: 0;
                    padding-left: 5px;
                    padding-right: 3px;
                    padding-top: 16px;
                    padding-bottom: 16px;

                    slim-scroll-track := Rectangle {
                        width: 6px;
                        vertical-stretch: 1;
                        border-radius: 3px;
                        background: Theme.scrollbar-track;

                        property <length> max-scroll: max(0px, narrow-content.preferred-height - narrow-flick.height);
                        property <length> thumb-height: narrow-content.preferred-height > narrow-flick.height
                            ? max(36px, self.height * (narrow-flick.height / narrow-content.preferred-height))
                            : self.height;
                        property <length> thumb-y: self.max-scroll > 0px
                            ? (self.height - self.thumb-height) * (-narrow-flick.content-y / self.max-scroll)
                            : 0px;

                        Rectangle {
                            x: 0px;
                            y: clamp(parent.thumb-y, 0px, max(0px, parent.height - self.height));
                            width: parent.width;
                            height: parent.thumb-height;
                            border-radius: 3px;
                            background: slim-scroll-touch.has-hover || slim-scroll-touch.pressed
                                ? Theme.scrollbar-thumb-hover
                                : Theme.scrollbar-thumb;
                        }

                        slim-scroll-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            moved => {
                                if (self.pressed && parent.max-scroll > 0px && parent.height > parent.thumb-height) {
                                    narrow-flick.content-y = clamp(
                                        -parent.max-scroll * ((self.mouse-y - parent.thumb-height / 2) / (parent.height - parent.thumb-height)),
                                        -parent.max-scroll,
                                        0px
                                    );
                                }
                            }
                            clicked => {
                                if (parent.max-scroll > 0px && parent.height > parent.thumb-height) {
                                    narrow-flick.content-y = clamp(
                                        -parent.max-scroll * ((self.mouse-y - parent.thumb-height / 2) / (parent.height - parent.thumb-height)),
                                        -parent.max-scroll,
                                        0px
                                    );
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    max-width: 560px;
                    horizontal-stretch: 10;
                    padding-left: 10px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 14px;

                    // Collapsible Settings Drawer Card
                    if root.settings-open: SurfaceCard {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: stretch;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Text {
                                        text: @tr("Appearance");
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Palette.foreground;
                                    }
                                }

                                ComboBox {
                                    model: [@tr("System theme"), @tr("Light theme"), @tr("Dark theme")];
                                    current-index: root.theme == ThemePreference.light ? 1 : root.theme == ThemePreference.dark ? 2 : 0;
                                    selected => {
                                        root.theme = self.current-index == 1 ? ThemePreference.light
                                            : self.current-index == 2 ? ThemePreference.dark
                                            : ThemePreference.system;
                                        root.apply-theme();
                                        root.theme-selected(root.theme);
                                    }
                                }

                                Button {
                                    text: @tr("About");
                                    clicked => { about-popup.show(); }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.divider;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                LineEdit {
                                    text <=> root.draft-package-name;
                                    placeholder-text: @tr("Register custom software package…");
                                    horizontal-stretch: 1;
                                    accepted => { root.submit(); }
                                }

                                Button {
                                    text: @tr("Register");
                                    primary: true;
                                    clicked => { root.submit(); }
                                }

                                Button {
                                    text: @tr("Refresh");
                                    clicked => { root.refresh-packages(); }
                                }
                            }

                            if root.error-message != "": Text {
                                text: root.error-message;
                                font-size: 12px;
                                color: Theme.critical-foreground;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Search Bar Card (replaces single-tab bar; filters both Installed & Available)
                    SurfaceCard {
                        height: 44px;
                        vertical-stretch: 0;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            spacing: 10px;
                            alignment: stretch;

                            VerticalLayout {
                                alignment: center;

                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("assets/search.svg");
                                    colorize: Theme.muted-foreground;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;

                                LineEdit {
                                    text <=> root.search-query;
                                    placeholder-text: @tr("Search software…");
                                    edited => {
                                        root.search-edited(self.text);
                                    }
                                }
                            }
                        }
                    }

                    // Scrollable Software Cards driven by narrow-flick
                    narrow-flick := Flickable {
                        vertical-stretch: 1;
                        interactive: true;
                        content-width: self.width;
                        content-height: narrow-content.preferred-height;

                        narrow-content := VerticalLayout {
                            width: parent.width;
                            spacing: 14px;
                            padding-bottom: 8px;
                            alignment: start;

                            // Installed Software Card
                            SurfaceCard {
                                VerticalLayout {
                                    padding-top: 14px;
                                    padding-bottom: 8px;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;

                                    // Card Header with Installed Count + Updates Button
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        padding-bottom: 4px;
                                        spacing: 8px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            alignment: center;

                                            Text {
                                                text: @tr("Installed");
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.muted-foreground;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;

                                            Text {
                                                text: root.installed-packages.length;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: Theme.subtle-foreground;
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }

                                        if root.updates-count > 0: Button {
                                            text: @tr("Update all ({})", root.updates-count);
                                        }
                                    }

                                    for package[idx] in root.installed-packages: PackageListItem {
                                        package: package;
                                        show-divider: idx < root.installed-packages.length - 1;
                                        clicked => { root.selected-package = package; }
                                    }

                                    if root.installed-packages.length == 0: VerticalLayout {
                                        padding: 16px;

                                        Text {
                                            text: @tr("No matching installed software.");
                                            font-size: 13px;
                                            color: Theme.muted-foreground;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Available Software Card
                            SurfaceCard {
                                VerticalLayout {
                                    padding-top: 12px;
                                    padding-bottom: root.available-expanded ? 8px : 12px;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;

                                    // Collapsible Card Header with Available Count
                                    Rectangle {
                                        height: 30px;
                                        border-radius: 6px;
                                        background: available-header-touch.has-hover
                                            ? Theme.hover-background
                                            : Colors.transparent;

                                        available-header-touch := TouchArea {
                                            clicked => {
                                                root.available-expanded = !root.available-expanded;
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            alignment: stretch;

                                            VerticalLayout {
                                                alignment: center;

                                                Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: root.available-expanded
                                                        ? @image-url("assets/chevron-down.svg")
                                                        : @image-url("assets/chevron-right.svg");
                                                    colorize: Theme.muted-foreground;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;

                                                Text {
                                                    text: @tr("Available software");
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: Theme.muted-foreground;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;

                                                Text {
                                                    text: root.available-packages.length;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    color: Theme.subtle-foreground;
                                                }
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }

                                    if root.available-expanded: VerticalLayout {
                                        spacing: 0px;

                                        for package[idx] in root.available-packages: PackageListItem {
                                            package: package;
                                            show-divider: idx < root.available-packages.length - 1;
                                            clicked => { root.selected-package = package; }
                                        }

                                        if root.available-packages.length == 0: VerticalLayout {
                                            padding: 16px;

                                            Text {
                                                text: @tr("No matching available software.");
                                                font-size: 13px;
                                                color: Theme.muted-foreground;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            // WIDE STEAM-STYLE SPLIT VIEW (>= 760px): Software List + Search on Left, Detail & Actions on Right
            if root.wide-layout: VerticalLayout {
                vertical-stretch: 1;
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 14px;

                // Collapsible Settings Drawer Card
                if root.settings-open: SurfaceCard {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: stretch;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;

                                Text {
                                    text: @tr("Appearance");
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                            }

                            ComboBox {
                                model: [@tr("System theme"), @tr("Light theme"), @tr("Dark theme")];
                                current-index: root.theme == ThemePreference.light ? 1 : root.theme == ThemePreference.dark ? 2 : 0;
                                selected => {
                                    root.theme = self.current-index == 1 ? ThemePreference.light
                                        : self.current-index == 2 ? ThemePreference.dark
                                        : ThemePreference.system;
                                    root.apply-theme();
                                    root.theme-selected(root.theme);
                                }
                            }

                            Button {
                                text: @tr("About");
                                clicked => { about-popup.show(); }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.divider;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            LineEdit {
                                text <=> root.draft-package-name;
                                placeholder-text: @tr("Register custom software package…");
                                horizontal-stretch: 1;
                                accepted => { root.submit(); }
                            }

                            Button {
                                text: @tr("Register");
                                primary: true;
                                clicked => { root.submit(); }
                            }

                            Button {
                                text: @tr("Refresh");
                                clicked => { root.refresh-packages(); }
                            }
                        }

                        if root.error-message != "": Text {
                            text: root.error-message;
                            font-size: 12px;
                            color: Theme.critical-foreground;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 16px;

                    // Left Sidebar: Search Bar + Installed & Available Software List
                    SurfaceCard {
                        width: 330px;
                        horizontal-stretch: 0;

                        VerticalLayout {
                            spacing: 0px;

                            // Sidebar Search Bar at Top of Left Column
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 8px;
                                alignment: stretch;

                                VerticalLayout {
                                    alignment: center;

                                    Image {
                                        width: 15px;
                                        height: 15px;
                                        source: @image-url("assets/search.svg");
                                        colorize: Theme.muted-foreground;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    LineEdit {
                                        text <=> root.search-query;
                                        placeholder-text: @tr("Search software…");
                                        edited => {
                                            root.search-edited(self.text);
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.divider;
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                width: 100%;
                                horizontal-scrollbar-policy: always-off;

                                VerticalLayout {
                                    padding-top: 10px;
                                    padding-bottom: 12px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: start;

                                    // Installed Section Header with Count
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-bottom: 4px;
                                        spacing: 6px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            alignment: center;

                                            Text {
                                                text: @tr("Installed");
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: Theme.muted-foreground;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;

                                            Text {
                                                text: root.installed-packages.length;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: Theme.subtle-foreground;
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }

                                        if root.updates-count > 0: Button {
                                            text: @tr("Update all ({})", root.updates-count);
                                        }
                                    }

                                    for package in root.installed-packages: PackageListItem {
                                        package: package;
                                        compact: true;
                                        selected: root.selected-package.id == package.id;
                                        clicked => {
                                            root.selected-package = package;
                                        }
                                    }

                                    Rectangle {
                                        height: 1px;
                                        background: Theme.divider;
                                    }

                                    // Available Software Section Header with Count
                                    Rectangle {
                                        height: 28px;
                                        border-radius: 6px;
                                        background: sidebar-available-touch.has-hover
                                            ? Theme.hover-background
                                            : Colors.transparent;

                                        sidebar-available-touch := TouchArea {
                                            clicked => {
                                                root.available-expanded = !root.available-expanded;
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 6px;
                                            alignment: stretch;

                                            VerticalLayout {
                                                alignment: center;

                                                Image {
                                                    width: 12px;
                                                    height: 12px;
                                                    source: root.available-expanded
                                                        ? @image-url("assets/chevron-down.svg")
                                                        : @image-url("assets/chevron-right.svg");
                                                    colorize: Theme.muted-foreground;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;

                                                Text {
                                                    text: @tr("Available software");
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: Theme.muted-foreground;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;

                                                Text {
                                                    text: root.available-packages.length;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    color: Theme.subtle-foreground;
                                                }
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }

                                    if root.available-expanded: VerticalLayout {
                                        spacing: 2px;

                                        for package in root.available-packages: PackageListItem {
                                            package: package;
                                            compact: true;
                                            selected: root.selected-package.id == package.id;
                                            clicked => {
                                                root.selected-package = package;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right Detail Pane: Selected Software Hero, Actions & Description
                    PackageDetailPane {
                        horizontal-stretch: 1;
                        package: root.selected-package;
                    }
                }
            }
        }

        // Right-edge resize grip for frameless window
        Rectangle {
            x: parent.width - 5px;
            y: 36px;
            width: 5px;
            height: parent.height - 44px;

            TouchArea {
                mouse-cursor: ew-resize;
                moved => {
                    if (self.pressed) {
                        root.resize-window-east(self.mouse-x - self.pressed-x);
                    }
                }
            }
        }

        // Bottom-edge resize grip for frameless window
        Rectangle {
            x: 0px;
            y: parent.height - 5px;
            width: parent.width - 10px;
            height: 5px;

            TouchArea {
                mouse-cursor: ns-resize;
                moved => {
                    if (self.pressed) {
                        root.resize-window-south(self.mouse-y - self.pressed-y);
                    }
                }
            }
        }

        // Bottom-right corner resize grip for frameless window
        Rectangle {
            x: parent.width - 10px;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;

            TouchArea {
                mouse-cursor: nwse-resize;
                moved => {
                    if (self.pressed) {
                        root.resize-window-southeast(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
            }
        }
    }
}
