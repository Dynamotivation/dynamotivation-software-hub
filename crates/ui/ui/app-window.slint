import { AboutSlint, Button, ComboBox, LineEdit, Palette, ScrollView, VerticalBox } from "std-widgets.slint";
import { PackageRow, PackageStatus, ThemePreference } from "types.slint";
import { Theme } from "theme.slint";
import { SurfaceCard } from "components/card.slint";
import { PackageListItem } from "components/package-list-item.slint";

// Re-export so the generated Rust API contains these types.
export { PackageRow, PackageStatus, ThemePreference }

export component AppWindow inherits Window {
    title: @tr("Dynamotivation Software Hub");
    preferred-width: 520px;
    preferred-height: 780px;
    min-width: 440px;
    min-height: 520px;
    background: Palette.background;

    in property <[PackageRow]> packages: [];
    in property <[PackageRow]> installed-packages: [];
    in property <[PackageRow]> available-packages: [];
    in property <int> updates-count: 0;
    in property <string> error-message;
    in property <string> version;
    in-out property <ThemePreference> theme: ThemePreference.system;
    // Resolved OS dark-mode flag so "System theme" sets an explicit scheme.
    in property <bool> system-dark: false;

    property <bool> available-expanded: true;
    property <bool> settings-open: false;
    property <string> draft-package-name: "";

    // Returns true on success; Rust sets `error-message` otherwise.
    callback register-package(string) -> bool;
    callback refresh-packages();
    callback theme-selected(ThemePreference);

    function apply-theme() {
        Palette.color-scheme = root.theme == ThemePreference.dark ? ColorScheme.dark
            : root.theme == ThemePreference.light ? ColorScheme.light
            : root.system-dark ? ColorScheme.dark : ColorScheme.light;
    }

    function submit() {
        if (root.register-package(root.draft-package-name)) {
            root.draft-package-name = "";
        }
    }

    init => { root.apply-theme(); }
    changed theme => { root.apply-theme(); }
    changed system-dark => { root.apply-theme(); }

    about-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 320px;

        Rectangle {
            background: Theme.card-background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.card-border;

            VerticalBox {
                Text {
                    text: @tr("Dynamotivation Software Hub {}", root.version);
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }
                AboutSlint { }
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.window-background;

        VerticalLayout {
            spacing: 0px;

            // Dynamotivation Website-Styled Header Banner (#ff4c4a -> #893750 + mint/cyan accent strip)
            Rectangle {
                height: 75px;
                vertical-stretch: 0;
                background: Theme.header-background;

                VerticalLayout {
                    HorizontalLayout {
                        vertical-stretch: 1;

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            max-width: 560px;
                            horizontal-stretch: 10;
                            padding-left: 22px;
                            padding-right: 22px;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            spacing: 14px;
                            alignment: stretch;

                            // Brand Logo (Mint/Cyan 'D' with white inner counter on coral/maroon banner)
                            VerticalLayout {
                                alignment: center;

                                Image {
                                    width: 40px;
                                    height: 40px;
                                    source: @image-url("assets/dynamotivation-logo-dark.svg");
                                    image-fit: contain;
                                }
                            }

                            // Brand Title Stack
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px;
                                alignment: center;

                                Text {
                                    text: @tr("Dynamotivation");
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.header-muted-foreground;
                                }

                                Text {
                                    text: @tr("Software Hub");
                                    font-size: 21px;
                                    font-weight: 700;
                                    color: Theme.header-foreground;
                                }
                            }

                            // Settings Button
                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 9px;
                                    background: settings-touch.has-hover || root.settings-open
                                        ? Theme.header-hover-background
                                        : Colors.transparent;

                                    settings-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: @tr("Settings");
                                        clicked => {
                                            root.settings-open = !root.settings-open;
                                        }
                                    }

                                    Image {
                                        width: 20px;
                                        height: 20px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("assets/settings.svg");
                                        colorize: Theme.header-foreground;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    // Signature mint-to-cyan gradient accent bar at bottom of header
                    Rectangle {
                        height: 3px;
                        vertical-stretch: 0;
                        background: Theme.brand-gradient;
                    }
                }
            }

            // Main Content Column
            HorizontalLayout {
                vertical-stretch: 1;

                Rectangle {
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    max-width: 560px;
                    horizontal-stretch: 10;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 14px;

                    // Collapsible Settings Drawer Card
                    if root.settings-open: SurfaceCard {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: stretch;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Text {
                                        text: @tr("Appearance");
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Palette.foreground;
                                    }
                                }

                                ComboBox {
                                    model: [@tr("System theme"), @tr("Light theme"), @tr("Dark theme")];
                                    current-index: root.theme == ThemePreference.light ? 1 : root.theme == ThemePreference.dark ? 2 : 0;
                                    selected => {
                                        root.theme = self.current-index == 1 ? ThemePreference.light
                                            : self.current-index == 2 ? ThemePreference.dark
                                            : ThemePreference.system;
                                        root.apply-theme();
                                        root.theme-selected(root.theme);
                                    }
                                }

                                Button {
                                    text: @tr("About");
                                    clicked => { about-popup.show(); }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.divider;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                LineEdit {
                                    text <=> root.draft-package-name;
                                    placeholder-text: @tr("Register custom software package…");
                                    horizontal-stretch: 1;
                                    accepted => { root.submit(); }
                                }

                                Button {
                                    text: @tr("Register");
                                    primary: true;
                                    clicked => { root.submit(); }
                                }

                                Button {
                                    text: @tr("Refresh");
                                    clicked => { root.refresh-packages(); }
                                }
                            }

                            if root.error-message != "": Text {
                                text: root.error-message;
                                font-size: 12px;
                                color: Theme.critical-foreground;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Top Navigation & Status Bar Card
                    SurfaceCard {
                        height: 46px;
                        vertical-stretch: 0;

                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 16px;
                            spacing: 16px;
                            alignment: stretch;

                            // Active Tab ("Software") with Dynamotivation gradient underline
                            VerticalLayout {
                                alignment: stretch;

                                HorizontalLayout {
                                    vertical-stretch: 1;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;

                                        Text {
                                            text: @tr("Software");
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: Palette.foreground;
                                        }
                                    }

                                    if root.updates-count > 0: VerticalLayout {
                                        alignment: center;

                                        Rectangle {
                                            height: 18px;
                                            min-width: 18px;
                                            border-radius: 9px;
                                            background: Theme.brand-gradient;

                                            Text {
                                                text: root.updates-count;
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #111111;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 3px;
                                    border-radius: 1.5px;
                                    background: Theme.brand-gradient;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            VerticalLayout {
                                alignment: center;

                                Text {
                                    text: @tr("{} installed · {} available", root.installed-packages.length, root.available-packages.length);
                                    font-size: 12px;
                                    color: Theme.muted-foreground;
                                }
                            }
                        }
                    }

                    // Scrollable Software Sections
                    ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;

                        VerticalLayout {
                            spacing: 14px;
                            padding-bottom: 8px;
                            alignment: start;

                            // Installed Software Card
                            SurfaceCard {
                                VerticalLayout {
                                    padding-top: 14px;
                                    padding-bottom: 8px;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;

                                    // Card Header
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        padding-bottom: 4px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;

                                            Text {
                                                text: @tr("Installed");
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.muted-foreground;
                                            }
                                        }

                                        if root.updates-count > 0: Button {
                                            text: @tr("Update all");
                                        }
                                    }

                                    for package[idx] in root.installed-packages: PackageListItem {
                                        package: package;
                                        show-divider: idx < root.installed-packages.length - 1;
                                    }

                                    if root.installed-packages.length == 0: VerticalLayout {
                                        padding: 16px;

                                        Text {
                                            text: @tr("No software installed yet.");
                                            font-size: 13px;
                                            color: Theme.muted-foreground;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Available Software Card
                            SurfaceCard {
                                VerticalLayout {
                                    padding-top: 12px;
                                    padding-bottom: root.available-expanded ? 8px : 12px;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;

                                    // Collapsible Card Header
                                    Rectangle {
                                        height: 30px;
                                        border-radius: 6px;
                                        background: available-header-touch.has-hover
                                            ? Theme.hover-background
                                            : Colors.transparent;

                                        available-header-touch := TouchArea {
                                            clicked => {
                                                root.available-expanded = !root.available-expanded;
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 14px;
                                            spacing: 6px;
                                            alignment: stretch;

                                            VerticalLayout {
                                                alignment: center;

                                                Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: root.available-expanded
                                                        ? @image-url("assets/chevron-down.svg")
                                                        : @image-url("assets/chevron-right.svg");
                                                    colorize: Theme.muted-foreground;
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;

                                                Text {
                                                    text: @tr("Available software");
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: Theme.muted-foreground;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;

                                                Text {
                                                    text: root.available-packages.length;
                                                    font-size: 12px;
                                                    color: Theme.subtle-foreground;
                                                }
                                            }
                                        }
                                    }

                                    if root.available-expanded: VerticalLayout {
                                        spacing: 0px;

                                        for package[idx] in root.available-packages: PackageListItem {
                                            package: package;
                                            show-divider: idx < root.available-packages.length - 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
