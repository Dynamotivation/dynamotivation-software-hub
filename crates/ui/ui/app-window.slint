import { AboutSlint, Palette, VerticalBox } from "std-widgets.slint";
import { PackageRow, PackageStatus, ReleaseNote, ThemePreference } from "types.slint";
import { Theme } from "theme.slint";
import { IconButton } from "components/icon-button.slint";
import { PackageSidebar } from "components/package-sidebar.slint";
import { PackageDetailPane } from "components/package-detail-pane.slint";
import { ProgressRing } from "components/progress-ring.slint";
import { SettingsView } from "components/settings-view.slint";
import { TooltipArea } from "components/tooltip-area.slint";
import { TooltipOverlay } from "components/tooltip.slint";

// Re-export so the generated Rust API contains these types.
export { PackageRow, PackageStatus, ReleaseNote, ThemePreference }

// Windows 11 style caption button (minimize / maximize / close).
component CaptionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> is-close: false;

    callback clicked();

    width: 46px;
    height: 32px;
    border-radius: 4px;
    background: root.is-close
        ? (touch.pressed ? Theme.window-close-pressed : touch.has-hover ? Theme.window-close-hover : Colors.transparent)
        : (touch.has-hover ? Theme.header-hover-background : Colors.transparent);

    touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => {
            root.clicked();
        }
    }

    Image {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: Theme.header-foreground;
    }
}

// Invisible edge strip that resizes the frameless window.
component ResizeGrip inherits TouchArea {
    callback dragged(length, length);

    moved => {
        if (self.pressed) {
            root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("Dynamotivation Software Hub");
    no-frame: true;
    preferred-width: 980px;
    preferred-height: 760px;
    min-width: 440px;
    min-height: 520px;
    // Matches the canvas so nothing light shows outside the rounded frame.
    background: Theme.window-background-solid;

    in property <[PackageRow]> installed-packages: [];
    in property <[PackageRow]> available-packages: [];
    in property <string> error-message;
    in property <string> version;
    in-out property <string> search-query: "";
    in-out property <ThemePreference> theme: ThemePreference.system;
    // Resolved OS dark-mode flag so "System theme" sets an explicit scheme.
    in property <bool> system-dark: false;
    in-out property <bool> is-maximized: false;
    // The OS already rounds and outlines the window (Windows 11 DWM).
    in property <bool> native-corners: false;
    // Newer Software Hub release, if any ("" = up to date).
    in property <string> hub-update-version: "";

    // Platform and background settings properties
    in-out property <bool> autostart-in-background: false;
    in-out property <bool> auto-check-updates: true;
    in-out property <bool> show-notifications: true;
    in-out property <bool> keep-running-in-background: true;

    // Currently selected package; Rust fills in the full row on refresh.
    in-out property <PackageRow> selected-package: { id: "geo-background-generator" };

    property <bool> wide-layout: self.width >= 760px;
    property <bool> settings-open: false;
    // Narrow layout: list and detail are separate pages.
    property <bool> narrow-detail-open: false;

    // Sample download progress for packages flagged as downloading (UI mock).
    property <float> download-progress: 0;
    Timer {
        interval: 40ms;
        running: true;
        triggered => {
            root.download-progress = root.download-progress >= 1 ? 0 : root.download-progress + 0.004;
        }
    }

    // Returns true on success; Rust sets `error-message` otherwise.
    callback register-package(string) -> bool;
    callback refresh-packages();
    callback search-edited(string);
    callback theme-selected(ThemePreference);
    callback hub-update-requested();

    // Settings callbacks
    callback autostart-toggled(bool);
    callback auto-updates-toggled(bool);
    callback notifications-toggled(bool);
    callback background-running-toggled(bool);

    // Custom frameless window chrome callbacks
    callback move-window(length, length);
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback resize-window-east(length);
    callback resize-window-west(length);
    callback resize-window-south(length);
    callback resize-window-southeast(length, length);
    callback resize-window-southwest(length, length);

    function apply-theme() {
        Palette.color-scheme = root.theme == ThemePreference.dark ? ColorScheme.dark
            : root.theme == ThemePreference.light ? ColorScheme.light
            : root.system-dark ? ColorScheme.dark : ColorScheme.light;
    }

    function select-package(package: PackageRow) {
        root.selected-package = package;
        root.narrow-detail-open = true;
    }

    init => {
        root.apply-theme();
    }
    changed theme => {
        root.apply-theme();
    }
    changed system-dark => {
        root.apply-theme();
    }

    about-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 320px;

        Rectangle {
            background: Theme.card-background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.card-border;

            VerticalBox {
                Text {
                    text: @tr("Dynamotivation Software Hub v{}", root.version);
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }

                AboutSlint { }
            }
        }
    }

    frame := Rectangle {
        property <bool> square: root.is-maximized || root.native-corners;

        background: Theme.window-background;
        border-radius: self.square ? 0px : 10px;
        border-width: self.square ? 0px : 1px;
        border-color: Theme.window-frame-border;
        clip: true;

        VerticalLayout {
            // Integrated title bar + brand header (no stock OS titlebar)
            Rectangle {
                height: 82px;
                background: Theme.header-background;

                TouchArea {
                    moved => {
                        if (self.pressed) {
                            root.move-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                    double-clicked => {
                        root.toggle-maximize-window();
                    }
                }

                VerticalLayout {
                    HorizontalLayout {
                        vertical-stretch: 1;
                        padding-left: 20px;
                        spacing: 12px;

                        // Brand logo + title
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 14px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;

                                Image {
                                    width: 40px;
                                    height: 40px;
                                    source: @image-url("assets/dynamotivation-logo-dark.svg");
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                spacing: 0px;
                                alignment: center;

                                Text {
                                    text: @tr("Dynamotivation");
                                    font-size: 13px;
                                    font-weight: 600;
                                    letter-spacing: 0.2px;
                                    color: Theme.header-muted-foreground;
                                }

                                Text {
                                    text: @tr("Software Hub");
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: Theme.header-foreground;
                                }
                            }
                        }

                        // Caption buttons on top, hub actions below
                        VerticalLayout {
                            HorizontalLayout {
                                alignment: end;
                                spacing: 2px;
                                padding-right: 6px;
                                padding-top: 4px;

                                CaptionButton {
                                    icon: @image-url("assets/window-minimize.svg");
                                    label: @tr("Minimize");
                                    clicked => {
                                        root.minimize-window();
                                    }
                                }

                                CaptionButton {
                                    icon: root.is-maximized
                                        ? @image-url("assets/window-restore.svg")
                                        : @image-url("assets/window-maximize.svg");
                                    label: root.is-maximized ? @tr("Restore") : @tr("Maximize");
                                    clicked => {
                                        root.toggle-maximize-window();
                                    }
                                }

                                CaptionButton {
                                    icon: @image-url("assets/window-close.svg");
                                    label: @tr("Close");
                                    is-close: true;
                                    clicked => {
                                        root.close-window();
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                padding-right: 12px;
                                padding-bottom: 8px;

                                // Software Hub self-update indicator
                                if root.hub-update-version != "": Rectangle {
                                    height: 30px;
                                    border-radius: 15px;
                                    background: hub-update-touch.pressed
                                        ? Theme.header-hover-background
                                        : hub-update-touch.has-hover ? Theme.header-hover-background : Theme.header-pill-background;

                                    hub-update-touch := TooltipArea {
                                        tooltip: @tr("Software Hub v{} is available. Restart to update.", root.hub-update-version);
                                        accessible-role: button;
                                        accessible-label: @tr("Update Software Hub");
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.hub-update-requested();
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 12px;
                                        spacing: 6px;

                                        VerticalLayout {
                                            alignment: center;

                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 8px;
                                                background: Theme.brand-gradient;

                                                Image {
                                                    width: 10px;
                                                    height: 10px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    source: @image-url("assets/arrow-up.svg");
                                                    colorize: #111111;
                                                }
                                            }
                                        }

                                        Text {
                                            text: @tr("Update Hub");
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.header-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                IconButton {
                                    icon: @image-url("assets/settings.svg");
                                    icon-size: 18px;
                                    icon-color: Theme.header-foreground;
                                    hover-background: Theme.header-hover-background;
                                    active: root.settings-open;
                                    tooltip: @tr("Settings");
                                    clicked => {
                                        root.settings-open = !root.settings-open;
                                    }
                                }
                            }
                        }
                    }

                    // Signature mint-to-cyan gradient accent bar at bottom of header
                    Rectangle {
                        height: 3px;
                        background: Theme.brand-gradient;
                    }
                }
            }

            // Content: catalog and settings cross-fade instead of popping.
            Rectangle {
                vertical-stretch: 1;

                catalog := Rectangle {
                    opacity: root.settings-open ? 0 : 1;
                    visible: self.opacity > 0;
                    animate opacity { duration: 180ms; easing: ease-in-out; }

                    // Wide: list on the left, detail on the right
                    if root.wide-layout: HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 16px;

                        PackageSidebar {
                            width: 320px;
                            installed-packages: root.installed-packages;
                            available-packages: root.available-packages;
                            selected-id: root.selected-package.id;
                            download-progress: root.download-progress;
                            search-query <=> root.search-query;
                            search-edited(text) => {
                                root.search-edited(text);
                            }
                            package-selected(package) => {
                                root.select-package(package);
                            }
                            check-for-updates => {
                                root.refresh-packages();
                            }
                        }

                        PackageDetailPane {
                            horizontal-stretch: 1;
                            package: root.selected-package;
                            download-progress: root.download-progress;
                        }
                    }

                    // Narrow: list page, then detail page with a back button
                    if !root.wide-layout && !root.narrow-detail-open: HorizontalLayout {
                        padding: 16px;
                        alignment: center;

                        PackageSidebar {
                            max-width: 560px;
                            horizontal-stretch: 1;
                            installed-packages: root.installed-packages;
                            available-packages: root.available-packages;
                            selected-id: root.selected-package.id;
                            highlight-selection: false;
                            download-progress: root.download-progress;
                            search-query <=> root.search-query;
                            search-edited(text) => {
                                root.search-edited(text);
                            }
                            package-selected(package) => {
                                root.select-package(package);
                            }
                            check-for-updates => {
                                root.refresh-packages();
                            }
                        }
                    }

                    if !root.wide-layout && root.narrow-detail-open: HorizontalLayout {
                        padding: 16px;

                        PackageDetailPane {
                            package: root.selected-package;
                            download-progress: root.download-progress;
                            show-back: true;
                            back-clicked => {
                                root.narrow-detail-open = false;
                            }
                        }
                    }
                }

                SettingsView {
                    y: root.settings-open ? 0px : 16px;
                    height: parent.height;
                    opacity: root.settings-open ? 1 : 0;
                    visible: self.opacity > 0;
                    animate opacity { duration: 180ms; easing: ease-in-out; }
                    animate y { duration: 220ms; easing: ease-out; }

                    theme <=> root.theme;
                    version: root.version;
                    error-message: root.error-message;
                    autostart-in-background <=> root.autostart-in-background;
                    auto-check-updates <=> root.auto-check-updates;
                    show-notifications <=> root.show-notifications;
                    keep-running-in-background <=> root.keep-running-in-background;

                    back-clicked => {
                        root.settings-open = false;
                    }
                    theme-selected(th) => {
                        root.apply-theme();
                        root.theme-selected(th);
                    }
                    autostart-toggled(val) => {
                        root.autostart-toggled(val);
                    }
                    auto-updates-toggled(val) => {
                        root.auto-updates-toggled(val);
                    }
                    notifications-toggled(val) => {
                        root.notifications-toggled(val);
                    }
                    background-running-toggled(val) => {
                        root.background-running-toggled(val);
                    }
                    register-package(name) => {
                        root.register-package(name)
                    }
                    refresh-packages => {
                        root.refresh-packages();
                    }
                    show-about => {
                        about-popup.show();
                    }
                }
            }
        }

        // Resize grips for the frameless window (left, right, bottom and corners)
        if !root.is-maximized: ResizeGrip {
            x: 0px;
            y: 0px;
            width: 5px;
            height: parent.height - 10px;
            mouse-cursor: ew-resize;
            dragged(dx, dy) => {
                root.resize-window-west(dx);
            }
        }

        if !root.is-maximized: ResizeGrip {
            x: parent.width - 5px;
            y: 36px;
            width: 5px;
            height: parent.height - 46px;
            mouse-cursor: ew-resize;
            dragged(dx, dy) => {
                root.resize-window-east(dx);
            }
        }

        if !root.is-maximized: ResizeGrip {
            x: 10px;
            y: parent.height - 5px;
            width: parent.width - 20px;
            height: 5px;
            mouse-cursor: ns-resize;
            dragged(dx, dy) => {
                root.resize-window-south(dy);
            }
        }

        if !root.is-maximized: ResizeGrip {
            x: 0px;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;
            mouse-cursor: nesw-resize;
            dragged(dx, dy) => {
                root.resize-window-southwest(dx, dy);
            }
        }

        if !root.is-maximized: ResizeGrip {
            x: parent.width - 10px;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;
            mouse-cursor: nwse-resize;
            dragged(dx, dy) => {
                root.resize-window-southeast(dx, dy);
            }
        }

        // Shared tooltip, drawn above everything else
        TooltipOverlay { }
    }
}
