import { Palette } from "std-widgets.slint";
import { PackageRow, PackageStatus } from "../types.slint";
import { Theme } from "../theme.slint";
import { PackageIcon } from "package-icon.slint";
import { ProgressRing } from "progress-ring.slint";

// One row of the software list. Selection is shown by shading alone.
export component PackageListItem inherits Rectangle {
    in property <PackageRow> package;
    in property <bool> selected: false;
    // Mock download progress shown when `package.downloading`.
    in property <float> download-progress: 0;

    callback clicked();

    property <bool> is-available: root.package.status == PackageStatus.not-installed;

    height: 54px;
    border-radius: 8px;
    background: root.selected
        ? Theme.selected-background
        : row-touch.has-hover ? Theme.hover-background : Colors.transparent;
    animate background { duration: 90ms; }

    row-touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: list-item;
        accessible-label: root.package.name;
        clicked => {
            root.clicked();
        }
    }

    // Software that isn't installed is shown slightly faded.
    Rectangle {
        opacity: root.is-available && !root.selected ? 0.8 : 1.0;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                PackageIcon {
                    width: 36px;
                    height: 36px;
                    package-id: root.package.id;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;

                Text {
                    text: root.package.name;
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    overflow: elide;
                }

                HorizontalLayout {
                    height: 16px;
                    spacing: 4px;
                    alignment: start;

                    Text {
                        text: @tr("v{}", root.package.status == PackageStatus.not-installed
                            ? root.package.latest-version
                            : root.package.version);
                        font-size: 12px;
                        color: Theme.muted-foreground;
                        vertical-alignment: center;
                    }

                    if root.package.status == PackageStatus.update-available: VerticalLayout {
                        alignment: center;

                        Image {
                            width: 11px;
                            height: 11px;
                            source: @image-url("../assets/arrow-right.svg");
                            colorize: Theme.muted-foreground;
                        }
                    }

                    if root.package.status == PackageStatus.update-available: Text {
                        text: @tr("v{}", root.package.latest-version);
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.brand-red;
                        vertical-alignment: center;
                    }
                }
            }

            if root.package.downloading: VerticalLayout {
                alignment: center;

                ProgressRing {
                    width: 18px;
                    height: 18px;
                    thickness: 2.5px;
                    progress: root.download-progress;
                }
            }
        }
    }
}
