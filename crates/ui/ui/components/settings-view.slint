import { LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ThemePreference } from "../types.slint";
import { SurfaceCard } from "card.slint";
import { ActionButton } from "action-button.slint";
import { IconButton } from "icon-button.slint";
import { PlatformToggle } from "toggle.slint";

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 700;
    color: Palette.foreground;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

// Selectable theme tile.
component ThemeOption inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected;

    callback clicked();

    horizontal-stretch: 1;
    height: 64px;
    border-radius: 10px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.brand-accent : Theme.card-border;
    background: root.selected
        ? Theme.selected-background
        : touch.has-hover ? Theme.hover-background : Colors.transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.title;
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 3px;
        padding-left: 12px;
        padding-right: 12px;

        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 700;
            color: Palette.foreground;
            horizontal-alignment: center;
        }

        Text {
            text: root.subtitle;
            font-size: 12px;
            color: Theme.muted-foreground;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Label + description on the left, toggle on the right.
component ToggleRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked;

    callback toggled(bool);

    spacing: 16px;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
        }

        Text {
            text: root.description;
            font-size: 12px;
            color: Theme.muted-foreground;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;

        PlatformToggle {
            checked <=> root.checked;
            toggled(val) => {
                root.toggled(val);
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    in-out property <ThemePreference> theme: ThemePreference.system;
    in property <string> version;
    in property <string> error-message;

    in-out property <bool> autostart-in-background: false;
    in-out property <bool> auto-check-updates: true;
    in-out property <bool> show-notifications: true;
    in-out property <bool> keep-running-in-background: true;

    in-out property <string> draft-package-name: "";

    callback back-clicked();
    callback theme-selected(ThemePreference);
    callback autostart-toggled(bool);
    callback auto-updates-toggled(bool);
    callback notifications-toggled(bool);
    callback background-running-toggled(bool);
    callback register-package(string) -> bool;
    callback refresh-packages();
    callback show-about();

    function select-theme(value: ThemePreference) {
        root.theme = value;
        root.theme-selected(value);
    }

    function submit-registration() {
        if (root.register-package(root.draft-package-name)) {
            root.draft-package-name = "";
        }
    }

    VerticalLayout {
        padding-top: 16px;
        spacing: 10px;

        // Header
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;

            IconButton {
                icon: @image-url("../assets/chevron-left.svg");
                icon-color: Palette.foreground;
                tooltip: @tr("Back to software");
                clicked => {
                    root.back-clicked();
                }
            }

            Text {
                text: @tr("Settings");
                font-size: 20px;
                font-weight: 700;
                color: Palette.foreground;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;

            HorizontalLayout {
                alignment: center;

                VerticalLayout {
                    max-width: 760px;
                    horizontal-stretch: 1;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 4px;
                    padding-bottom: 20px;
                    spacing: 16px;
                    alignment: start;

                    // Appearance
                    SurfaceCard {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            SectionTitle {
                                text: @tr("Appearance");
                            }

                            Divider { }

                            HorizontalLayout {
                                spacing: 12px;

                                ThemeOption {
                                    title: @tr("System");
                                    subtitle: @tr("Matches OS mode");
                                    selected: root.theme == ThemePreference.system;
                                    clicked => {
                                        root.select-theme(ThemePreference.system);
                                    }
                                }

                                ThemeOption {
                                    title: @tr("Light");
                                    subtitle: @tr("Vibrant coral");
                                    selected: root.theme == ThemePreference.light;
                                    clicked => {
                                        root.select-theme(ThemePreference.light);
                                    }
                                }

                                ThemeOption {
                                    title: @tr("Dark");
                                    subtitle: @tr("Deep maroon & charcoal");
                                    selected: root.theme == ThemePreference.dark;
                                    clicked => {
                                        root.select-theme(ThemePreference.dark);
                                    }
                                }
                            }
                        }
                    }

                    // System integration
                    SurfaceCard {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            SectionTitle {
                                text: @tr("System Integration");
                            }

                            Divider { }

                            ToggleRow {
                                title: @tr("Autostart in background");
                                description: @tr("Start the Software Hub silently when you log in");
                                checked <=> root.autostart-in-background;
                                toggled(val) => {
                                    root.autostart-toggled(val);
                                }
                            }

                            Divider { }

                            ToggleRow {
                                title: @tr("Keep running in background");
                                description: @tr("Stay in the system tray when the window is closed");
                                checked <=> root.keep-running-in-background;
                                toggled(val) => {
                                    root.background-running-toggled(val);
                                }
                            }

                            Divider { }

                            ToggleRow {
                                title: @tr("Automatically check for updates");
                                description: @tr("Periodically check whether installed software or the Hub has a newer version");
                                checked <=> root.auto-check-updates;
                                toggled(val) => {
                                    root.auto-updates-toggled(val);
                                }
                            }

                            Divider { }

                            ToggleRow {
                                title: @tr("Show notifications");
                                description: @tr("Notify me when updates or downloads complete");
                                checked <=> root.show-notifications;
                                toggled(val) => {
                                    root.notifications-toggled(val);
                                }
                            }
                        }
                    }

                    // Software registration
                    SurfaceCard {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            SectionTitle {
                                text: @tr("Software Registration");
                            }

                            Divider { }

                            Text {
                                text: @tr("Register custom software packages or manually trigger a catalog sync.");
                                font-size: 12px;
                                color: Theme.muted-foreground;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.draft-package-name;
                                    placeholder-text: @tr("Software name…");
                                    accepted => {
                                        root.submit-registration();
                                    }
                                }

                                ActionButton {
                                    text: @tr("Register");
                                    primary: true;
                                    clicked => {
                                        root.submit-registration();
                                    }
                                }

                                ActionButton {
                                    text: @tr("Refresh catalog");
                                    icon: @image-url("../assets/refresh.svg");
                                    has-icon: true;
                                    clicked => {
                                        root.refresh-packages();
                                    }
                                }
                            }

                            if root.error-message != "": Text {
                                text: root.error-message;
                                font-size: 12px;
                                color: Theme.critical-foreground;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // About
                    SurfaceCard {
                        HorizontalLayout {
                            padding: 18px;
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                alignment: center;

                                Text {
                                    text: @tr("Dynamotivation Software Hub");
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                }

                                Text {
                                    text: @tr("v{}", root.version);
                                    font-size: 12px;
                                    color: Theme.muted-foreground;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                ActionButton {
                                    text: @tr("About Slint");
                                    icon: @image-url("../assets/info.svg");
                                    has-icon: true;
                                    clicked => {
                                        root.show-about();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
