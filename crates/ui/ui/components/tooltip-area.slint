import { TooltipState } from "tooltip.slint";

// TouchArea that publishes a tooltip to the shared `TooltipOverlay` while hovered.
export component TooltipArea inherits TouchArea {
    in property <string> tooltip;

    function publish() {
        TooltipState.text = root.tooltip;
        TooltipState.anchor-x = root.absolute-position.x;
        TooltipState.anchor-y = root.absolute-position.y;
        TooltipState.anchor-width = root.width;
        TooltipState.anchor-height = root.height;
        TooltipState.active = root.tooltip != "";
    }

    changed has-hover => {
        if (self.has-hover) {
            root.publish();
        } else if (TooltipState.anchor-x == root.absolute-position.x
                && TooltipState.anchor-y == root.absolute-position.y) {
            TooltipState.active = false;
        }
    }

    // Keep the text live (e.g. "Checking for updates…") while hovered.
    changed tooltip => {
        if (self.has-hover) {
            root.publish();
        }
    }

    // Clicking dismisses the tooltip like native controls do.
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            TooltipState.active = false;
        }
    }
}
