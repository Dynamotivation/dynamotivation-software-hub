import { Theme } from "../theme.slint";

export component PlatformToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 44px;
    height: 22px;
    border-radius: 11px;
    clip: true;

    // Track background
    background: !root.enabled
        ? (Theme.dark ? #2c2f36 : #e0d8dc)
        : root.checked
            ? Theme.brand-accent
            : (Theme.dark ? #32353c : #d6cbd2);

    border-width: 1px;
    border-color: !root.enabled
        ? Colors.transparent
        : root.checked
            ? Theme.brand-accent
            : (Theme.dark ? #4a4f59 : #b8aeb5);

    animate background { duration: 160ms; easing: ease-in-out; }
    animate border-color { duration: 160ms; easing: ease-in-out; }

    // Toggle thumb circle
    thumb := Rectangle {
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked && !Theme.dark
            ? #ffffff
            : root.checked && Theme.dark
                ? #111111
                : (Theme.dark ? #c8ccd4 : #ffffff);

        x: root.checked ? parent.width - self.width - 3px : 3px;

        animate x { duration: 160ms; easing: ease-out; }
        animate background { duration: 160ms; easing: ease-in-out; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}
